{
  "manifest_version": 3,
  "name": "DensePress",
  "description": "Print web articles densely: Garamond 10pt, journal-style paragraphs, optional two columns, US Letter.",
  "homepage_url": "https://github.com/jeffg-dev/densepress",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_title": "DensePress: print this article",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}
